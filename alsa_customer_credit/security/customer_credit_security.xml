<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_alsa_customer_credit" model="ir.module.category">
        <field name="name">Saldos de clientes</field>
        <field name="description">Permisos para consultar y ajustar saldos a favor y saldos pendientes.</field>
        <field name="sequence">36</field>
    </record>

    <record id="privilege_alsa_customer_credit" model="res.groups.privilege">
        <field name="name">Saldos de clientes</field>
        <field name="description">Controla quién puede ajustar los saldos de clientes.</field>
        <field name="category_id" ref="module_category_alsa_customer_credit"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_alsa_customer_credit_manager" model="res.groups">
        <field name="name">Gestionar saldos de clientes</field>
        <field name="privilege_id" ref="privilege_alsa_customer_credit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Los usuarios de este grupo pueden ajustar saldos a favor y saldos pendientes. Todos los usuarios internos pueden consultarlos.</field>
    </record>

    <record id="rule_alsa_customer_credit_movement_company" model="ir.rule">
        <field name="name">Movimientos de saldo por compañías permitidas</field>
        <field name="model_id" ref="model_alsa_customer_credit_movement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
