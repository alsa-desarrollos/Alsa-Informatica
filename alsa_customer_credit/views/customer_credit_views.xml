<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_alsa_customer_credit_movement_search" model="ir.ui.view">
        <field name="name">alsa.customer.credit.movement.search</field>
        <field name="model">alsa.customer.credit.movement</field>
        <field name="arch" type="xml">
            <search string="Buscar movimientos">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <field name="reason"/>
                <filter name="filter_credit" string="Saldo a favor" domain="[('balance_kind', '=', 'credit')]"/>
                <filter name="filter_discount" string="Saldo pendiente" domain="[('balance_kind', '=', 'discount')]"/>
                <separator/>
                <filter name="group_balance_kind" string="Clase de saldo" context="{'group_by': 'balance_kind'}"/>
                <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                <filter name="group_month" string="Mes" context="{'group_by': 'movement_datetime:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_alsa_customer_credit_movement_list" model="ir.ui.view">
        <field name="name">alsa.customer.credit.movement.list</field>
        <field name="model">alsa.customer.credit.movement</field>
        <field name="arch" type="xml">
            <list string="Movimientos de saldos de clientes" create="0" edit="0" delete="0">
                <field name="movement_datetime"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="balance_kind" widget="badge"
                       decoration-success="balance_kind == 'credit'"
                       decoration-info="balance_kind == 'discount'"/>
                <field name="movement_type" widget="badge"
                       decoration-success="movement_type == 'increase'"
                       decoration-warning="movement_type == 'decrease'"/>
                <field name="amount" sum="Total de movimientos"/>
                <field name="balance_before" optional="hide"/>
                <field name="balance_after"/>
                <field name="reference" optional="show"/>
                <field name="reason" optional="show"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_alsa_customer_credit_movement_form" model="ir.ui.view">
        <field name="name">alsa.customer.credit.movement.form</field>
        <field name="model">alsa.customer.credit.movement</field>
        <field name="arch" type="xml">
            <form string="Movimiento de saldo de cliente" create="1" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="balance_kind" readonly="id"/>
                            <field name="movement_datetime"/>
                            <field name="movement_type" widget="badge" invisible="not id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="balance_before" invisible="not id"/>
                            <field name="amount" readonly="id"/>
                            <field name="balance_after" invisible="not id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="reference" readonly="id"/>
                        <field name="reason" readonly="id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_alsa_customer_credit_movements" model="ir.actions.act_window">
        <field name="name">Movimientos</field>
        <field name="res_model">alsa.customer.credit.movement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_alsa_customer_credit_movement_search"/>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>

    <record id="view_alsa_customer_balances_list" model="ir.ui.view">
        <field name="name">res.partner.alsa.customer.balances.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Saldos de clientes" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="parent_id" string="Empresa" optional="show"/>
                <field name="email" optional="hide"/>
                <field name="phone" optional="hide"/>
                <field name="alsa_credit_total_available"
                       string="Saldo a favor"
                       decoration-success="alsa_credit_total_available &gt; 0"/>
                <field name="alsa_discount_total_available"
                       string="Saldo pendiente"
                       decoration-info="alsa_discount_total_available &gt; 0"/>
                <field name="alsa_credit_currency_id" column_invisible="True"/>
                <button name="action_view_alsa_credit_movements"
                        type="object"
                        string="A favor"
                        icon="fa-money"/>
                <button name="action_view_alsa_discount_movements"
                        type="object"
                        string="Pendiente"
                        icon="fa-clock-o"/>
            </list>
        </field>
    </record>

    <record id="action_alsa_customer_balances" model="ir.actions.act_window">
        <field name="name">Saldos de clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_alsa_customer_balances_list"/>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_alsa_customer_credit_root"
              name="Saldos de clientes"
              action="action_alsa_customer_balances"
              sequence="45"
              groups="base.group_user"
              web_icon="alsa_customer_credit,static/description/icon.svg"/>
    <menuitem id="menu_alsa_customer_balances"
              name="Clientes y saldos"
              parent="menu_alsa_customer_credit_root"
              action="action_alsa_customer_balances"
              sequence="10"
              groups="base.group_user"/>
    <menuitem id="menu_alsa_customer_credit_movements"
              name="Movimientos"
              parent="menu_alsa_customer_credit_root"
              action="action_alsa_customer_credit_movements"
              sequence="20"
              groups="base.group_user"/>

    <record id="view_partner_form_alsa_customer_credit" model="ir.ui.view">
        <field name="name">res.partner.form.alsa.customer.credit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="alsa_licensing.view_partner_form_alsa_licensing"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_alsa_credit_movements"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="alsa_credit_total_available"
                                   widget="monetary"
                                   options="{'currency_field': 'alsa_credit_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Saldo a favor</span>
                    </div>
                </button>
                <button name="action_view_alsa_discount_movements"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock-o">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="alsa_discount_total_available"
                                   widget="monetary"
                                   options="{'currency_field': 'alsa_credit_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Saldo pendiente</span>
                    </div>
                </button>
                <field name="alsa_credit_currency_id" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='alsa_licensing']" position="after">
                <page string="Saldos" name="alsa_customer_balances">
                    <group>
                        <group string="Totales disponibles"
                               groups="alsa_customer_credit.group_alsa_customer_credit_manager">
                            <field name="alsa_credit_total_available"/>
                            <field name="alsa_discount_total_available"/>
                        </group>
                        <group string="Totales disponibles"
                               groups="base.group_user,!alsa_customer_credit.group_alsa_customer_credit_manager">
                            <field name="alsa_credit_total_available" readonly="1"/>
                            <field name="alsa_discount_total_available" readonly="1"/>
                        </group>
                        <field name="alsa_credit_currency_id" invisible="1"/>
                    </group>

                    <field name="alsa_balance_movement_ids"
                           context="{'alsa_credit_manual_create': True}"
                           groups="alsa_customer_credit.group_alsa_customer_credit_manager">
                        <list string="Movimientos de saldo"
                              editable="bottom"
                              create="1"
                              delete="0"
                              default_order="movement_datetime desc, id desc"
                              decoration-success="amount &gt; 0"
                              decoration-danger="amount &lt; 0">
                            <field name="id" column_invisible="True"/>
                            <field name="movement_datetime" readonly="1"/>
                            <field name="balance_kind" readonly="id"/>
                            <field name="amount" string="Movimiento (+/-)" readonly="id"/>
                            <field name="balance_after" readonly="1"/>
                            <field name="reference" readonly="id" optional="show"/>
                            <field name="reason" readonly="id"/>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>

                    <field name="alsa_balance_movement_ids"
                           readonly="1"
                           groups="base.group_user,!alsa_customer_credit.group_alsa_customer_credit_manager">
                        <list string="Movimientos de saldo"
                              create="0"
                              edit="0"
                              delete="0"
                              default_order="movement_datetime desc, id desc"
                              decoration-success="amount &gt; 0"
                              decoration-danger="amount &lt; 0">
                            <field name="movement_datetime"/>
                            <field name="balance_kind"/>
                            <field name="amount" string="Movimiento (+/-)"/>
                            <field name="balance_after"/>
                            <field name="reference" optional="show"/>
                            <field name="reason"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_form_alsa_customer_credit" model="ir.ui.view">
        <field name="name">sale.order.form.alsa.customer.credit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_alsa_credit_movements"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="not partner_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="alsa_credit_total_available"
                                   widget="monetary"
                                   options="{'currency_field': 'alsa_credit_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Saldo a favor</span>
                    </div>
                </button>
                <button name="action_view_alsa_discount_movements"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock-o"
                        invisible="not partner_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="alsa_discount_total_available"
                                   widget="monetary"
                                   options="{'currency_field': 'alsa_credit_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Saldo pendiente</span>
                    </div>
                </button>
                <field name="alsa_credit_currency_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_helpdesk_ticket_form_alsa_customer_credit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.alsa.customer.credit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_alsa_credit_movements"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="not partner_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="alsa_credit_total_available"
                                   widget="monetary"
                                   options="{'currency_field': 'alsa_credit_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Saldo a favor</span>
                    </div>
                </button>
                <button name="action_view_alsa_discount_movements"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock-o"
                        invisible="not partner_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="alsa_discount_total_available"
                                   widget="monetary"
                                   options="{'currency_field': 'alsa_credit_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Saldo pendiente</span>
                    </div>
                </button>
                <field name="alsa_credit_currency_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
