<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cotizaciones_express" model="ir.module.category">
        <field name="name">Cotizaciones Express</field>
        <field name="description">Permisos para acceder y administrar Cotizaciones Express.</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_cotizaciones_express" model="res.groups.privilege">
        <field name="name">Cotizaciones Express</field>
        <field name="description">Controla quién puede utilizar el módulo de Cotizaciones Express.</field>
        <field name="category_id" ref="module_category_cotizaciones_express"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_cotizaciones_express_user" model="res.groups">
        <field name="name">Acceso</field>
        <field name="privilege_id" ref="privilege_cotizaciones_express"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Los usuarios de este grupo pueden consultar y administrar Cotizaciones Express.</field>
    </record>
</odoo>
